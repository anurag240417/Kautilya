# Kautilya — Environment Variables
#
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env — it is gitignored.

# Path to the dataset root directory (contains EllipticPlusPlus/, elliptic_bitcoin_dataset/)
# KAUTILYA_DATASET_DIR=./dataset

# Path to saved model artifacts
# KAUTILYA_MODELS_DIR=./backend/models

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# KAUTILYA_LOG_LEVEL=INFO